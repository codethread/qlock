{
	"name": "qlock",
	"version": "0.10.2",
	"private": true,
	"description": "Ticketed local command queues for agents and shells",
	"homepage": "https://github.com/codethread/qlock",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/codethread/qlock.git"
	},
	"bin": {
		"qlock": "./bin/qlock.ts"
	},
	"workspaces": [
		".botlake"
	],
	"type": "module",
	"scripts": {
		"fmt": "oxfmt && bun run --filter qlock-lake fmt",
		"fmt:check": "oxfmt --check && bun run --filter qlock-lake fmt:check",
		"lint": "oxlint --deny-warnings && bun run --filter qlock-lake lint",
		"typecheck": "tsc --noEmit && bun run --filter qlock-lake typecheck",
		"changelog:generate": "bun run ./scripts/generate-changelog.ts",
		"test": "bun test ./tests",
		"test:unit": "bun test ./tests/*.test.ts",
		"test:integration": "bun test ./tests/integration",
		"build": "bun build ./bin/qlock.ts --compile --outfile ./dist/qlock",
		"install:bin": "bun run ./scripts/install.ts",
		"check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test"
	},
	"dependencies": {
		"@codethread/cli-changelog": "github:codethread/cli-changelog#c457e0a28686ce6349ce0956b1375635d53148d8",
		"commander": "^15.0.0",
		"gray-matter": "^4.0.3",
		"skills-handler": "^0.1.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.2",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@botlake/core": "0.4.0"
	},
	"packageManager": "bun@1.4.2"
}
